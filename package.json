{
    "name": "esifycss-webpack-plugin",
    "version": "0.1.3",
    "license": "Apache-2.0",
    "author": {
        "name": "Kei Ito",
        "email": "kei.itof@gmail.com",
        "url": "https://github.com/kei-ito"
    },
    "homepage": "https://github.com/kei-ito/esifycss-webpack-plugin",
    "repository": "https://github.com/kei-ito/esifycss-webpack-plugin",
    "engines": {
        "node": ">=12"
    },
    "main": "./lib/cjs.js",
    "files": [
        "lib"
    ],
    "scripts": {
        "build": "tsc --project tsconfig.build.json",
        "test": "run-s test:*",
        "test:type": "tsc --noEmit",
        "test:unit": "ava",
        "lint": "biome lint src",
        "version": "run-s version:changelog version:add",
        "version:changelog": "npx @nlib/changelog --output CHANGELOG.md",
        "version:add": "git add ."
    },
    "devDependencies": {
        "@biomejs/biome": "2.6.7",
        "@nlib/githooks": "0.2.2",
        "@types/node": "26.6.6",
        "ava": "5.3.1",
        "lint-staged": "11.2.6",
        "npm-run-all": "4.1.5",
        "ts-node": "10.9.2",
        "typescript": "4.9.5",
        "webpack": "5.112.2"
    },
    "ava": {
        "extensions": [
            "ts"
        ],
        "require": [
            "ts-node/register"
        ],
        "files": [
            "test/**/*.test.ts"
        ]
    },
    "lint-staged": {
        "*.{ts,js}": [
            "biome lint --no-errors-on-unmatched"
        ]
    },
    "renovate": {
        "extends": [
            "github>nlibjs/renovate-config"
        ]
    }
}
