{
    "compilerOptions": {
        "target": "es2019",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "resolveJsonModule": true,
        "strict": true,
        "removeComments": true,
        "declaration": true,
        "sourceMap": false,
        "noFallthroughCasesInSwitch": true,
        "noImplicitReturns": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "rootDir": ".",
        "types": [
            "node"
        ]
    },
    "exclude": [
        "lib/**/*",
        ".test-build/**/*"
    ]
}
